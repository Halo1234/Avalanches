@macro name=cell
@option clip_left=%x clip_top=%y clip_width=128 clip_height=128
@wait time=%time|500
@endmacro

@macro name=cell2
@option clip_left=%x clip_top=%y clip_width=64 clip_height=64 visible=%visible|true
@wait time=%time|100
@endmacro
@s

*front
*front_double_speed
*front_double_speed_armor
*front_double_speed_weapon
*front_double_speed_weapon_armor
@cell x=128 y=128
@s

*front_confuse
*front_make_slow
*front_do_not_move
*front_can_not_act
*front_blind
*front_poison
@load_cell storage=Roguelike_毒状態エフェクト
@cell2 x=0 y=0
@s

*front_attack
@cell x=128 y=256
@s

*front_long_attack
@cell x=128 y=256
@s

*front_long_long_attack
@cell x=128 y=256
