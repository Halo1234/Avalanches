;
; rouglelike_main_character.asdx
;

@macro name=cell
@option clip_left=%x clip_top=%y clip_width=128 clip_height=128
@wait time=%time|100
@endmacro

@macro name=cell2
@option clip_left=%x clip_top=%y clip_width=64 clip_height=64
@wait time=%time|100
@endmacro
@s

*front
*front_throw
*front_attack
*front_confuse
*front_make_slow
*front_do_not_move
*front_blind
@cell x=384 y=128
@s

*back
*back_throw
*back_attack
*back_confuse
*back_make_slow
*back_do_not_move
*back_blind
@cell x=256 y=128
@s

*left
*left_throw
*left_attack
*left_confuse
*left_make_slow
*left_do_not_move
*left_blind
@cell x=384 y=0
@s

*right
*right_throw
*right_attack
*right_confuse
*right_make_slow
*right_do_not_move
*right_blind
@cell x=0 y=0
@s

*left_front
*left_front_throw
*left_front_attack
*left_front_confuse
*left_front_make_slow
*left_front_do_not_move
*left_front_blind
@cell x=128 y=128
@s

*right_front
*right_front_throw
*right_front_attack
*right_front_confuse
*right_front_make_slow
*right_front_do_not_move
*right_front_blind
@cell x=256 y=0
@s

*left_back
*left_back_throw
*left_back_attack
*left_back_confuse
*left_back_make_slow
*left_back_do_not_move
*left_back_blind
@cell x=0 y=128
@s

*right_back
*right_back_throw
*right_back_attack
*right_back_confuse
*right_back_make_slow
*right_back_do_not_move
*right_back_blind
@cell x=128 y=0
@s

*sleep
@cell2 x=512 y=0
@s

*damage
@cell2 x=576 y=0 time=500
@s

*eat
@cell2 x=640 y=0
@cell2 x=704 y=0
@cell2 x=768 y=0
@cell2 x=640 y=64
@cell2 x=704 y=64
@cell2 x=768 y=64
@cell2 x=640 y=128
@cell2 x=704 y=128
@cell2 x=768 y=128
@s

