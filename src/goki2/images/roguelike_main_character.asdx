;
; rouglelike_main_character.asdx
;

@macro name=cell
@option clip_left=%x clip_top=%y clip_width=128 clip_height=128
@wait time=%time|100
@endmacro
@s

*front
*front_throw
*front_attack
@cell x=384 y=128
@s

*back
*back_throw
*back_attack
@cell x=256 y=128
@s

*left
*left_throw
*left_attack
@cell x=384 y=0
@s

*right
*right_throw
*right_attack
@cell x=0 y=0
@s

*left_front
*left_front_throw
*left_front_attack
@cell x=128 y=128
@s

*right_front
*right_front_throw
*right_front_attack
@cell x=256 y=0
@s

*left_back
*left_back_throw
*left_back_attack
@cell x=0 y=128
@s

*right_back
*right_back_throw
*right_back_attack
@cell x=128 y=0
@s
