
;
; rouglelike_npc_character.asdx
;

@macro name=cell
@option clip_left=%x clip_top=%y clip_width=128 clip_height=128
@wait time=%time|500
@endmacro

*front
@cell x=128 y=128
@s

*front_confuse
*front_make_slow
*front_do_not_move
*front_can_not_act
*front_blind
@s

*front_attack
@cell x=128 y=256
@s

*front_long_attack
@cell x=128 y=256
@s

*front_long_long_attack
@cell x=128 y=256
@s

