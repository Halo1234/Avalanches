
;
; rouglelike_main_character.asdx
;

@macro name=cell
@option clip_left=%x clip_top=%y clip_width=128 clip_height=128
@wait time=%time|500
@endmacro

@macro name=cell2
@option clip_left=%x clip_top=%y clip_width=64 clip_height=64
@wait time=%time|500
@endmacro

@macro name=cell_big
@option clip_left=%x clip_top=%y clip_width=192 clip_height=192
@wait time=%time|500
@endmacro
@s

*front
*front_confuse
*front_make_slow
*front_do_not_move
*front_can_not_act
*front_blind
@cell x=128 y=128
@s

*front_attack
@cell x=128 y=256
@s

*front_long_attack
@cell_big x=384 y=384
@s

*back
*back_confuse
*back_make_slow
*back_do_not_move
*back_can_not_act
*back_blind
@cell x=128 y=128
@s

*back_attack
@cell x=128 y=0
@s

*back_long_attack
@cell_big x=576 y=0
@s

