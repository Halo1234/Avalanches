
;
; rouglelike_main_character.asdx
;

@macro name=cell
@option clip_left=%x clip_top=%y clip_width=128 clip_height=128
@wait time=%time|500
@endmacro

@macro name=cell2
@option clip_left=%x clip_top=%y clip_width=64 clip_height=64
@wait time=%time|500
@endmacro

@macro name=cell_big
@option clip_left=%x clip_top=%y clip_width=192 clip_height=192
@wait time=%time|500
@endmacro
@s

*front
@cell x=128 y=128
@s

*front_attack
@cell x=128 y=256 time=100
@s

*front_long_attack
@cell_big x=384 y=384 time=100
@s

*back
@cell x=128 y=128
@s

*back_attack
@cell x=128 y=0 time=100
@s

*back_long_attack
@cell_big x=576 y=0 time=100
@s

*left
@cell x=128 y=128
@s

*left_attack
@cell x=0 y=128 time=100
@s

*left_long_attack
@cell_big x=384 y=192 time=100
@s

*right
@cell x=128 y=128
@s

*right_attack
@cell x=256 y=128 time=100
@s

*right_long_attack
@cell_big x=576 y=192 time=100
@s

*left_front
@cell x=128 y=128
@s

*left_front_attack
@cell x=0 y=256 time=100
@s

*left_front_long_attack
@cell_big x=768 y=192 time=100
@s

*right_front
@cell x=128 y=128
@s

*right_front_attack
@cell x=256 y=256 time=100
@s

*right_front_long_attack
@cell_big x=576 y=384 time=100
@s

*left_back
@cell x=128 y=128
@s

*left_back_attack
@cell x=0 y=0 time=100
@s

*left_back_long_attack
@cell_big x=384 y=0 time=100
@s

*right_back
@cell x=128 y=128
@s

*right_back_attack
@cell x=256 y=0 time=100
@s

*right_back_long_attack
@cell_big x=768 y=0 time=100
@s

*sleep
@cell2 x=960 y=0
@s

*damage
@cell x=1024 y=0 time=500
@s
